+# ---------------------------------------------------------------------------
+# Instrument projection and analytic covariance
+# ---------------------------------------------------------------------------
+
+
+def _project(D: np.ndarray, XZ: np.ndarray) -> np.ndarray:
+    """Least-squares projection of each column of ``D`` on ``XZ``.
+
+    ``XZ (XZ'XZ)^{-1} XZ'D``, the instrument R ``IVQR::ivqr`` builds.
+    """
+    coef = np.linalg.solve(XZ.T @ XZ, XZ.T @ D)
+    return XZ @ coef
+
+
+_VCE_KERNELS = ("epanechnikov", "uniform", "rectangle")
+
+
+def _vce_kernel(u: np.ndarray, kernel: str) -> np.ndarray:
+    """Kernel ``K(u)`` for the Jacobian (Stata ``kdensity`` conventions)."""
+    if kernel == "epanechnikov":
+        # Stata's "epanechnikov": 3/4 (1 - u^2/5) / sqrt(5) on |u| < sqrt(5)
+        return np.where(
+            np.abs(u) < np.sqrt(5.0), 0.75 * (1.0 - u * u / 5.0) / np.sqrt(5.0), 0.0
+        )
+    # "uniform" / "rectangle": 1/2 on |u| < 1 (Powell's estimator; R IVQR)
+    return np.where(np.abs(u) < 1.0, 0.5, 0.0)
+
+
+def _stata_pctile(x: np.ndarray, p: float) -> float:
+    """Stata ``_pctile`` (default definition): with ``k = n p / 100``, the
+    ``ceil(k)``-th order statistic, or the mean of the ``k``-th and
+    ``(k+1)``-th when ``k`` is an integer."""
+    xs = np.sort(np.asarray(x, dtype=float))
+    k = len(xs) * p / 100.0
+    i = int(np.floor(k))
+    if k == i:
+        return float(0.5 * (xs[i - 1] + xs[i]))
+    return float(xs[i])
+
+
+def _vce_bandwidth(e: np.ndarray, rule: Union[str, float]) -> float:
+    """Bandwidth for the Jacobian kernel.
+
+    ``'silverman'``: ``0.9 min(sd(e), IQR(e)/1.349) n^(-1/5)`` with Stata's
+    ``_pctile`` quartiles (average of the two order statistics when ``n p``
+    is an integer) -- Stata ``ivqregress``' default. ``'ivqr'``:
+    ``1.364 (2 sqrt(pi))^(-1/5) sd(e) n^(-1/5)`` -- R ``IVQR::ivqr.vc``.
+    A positive number is used as is.
+    """
+    n = len(e)
+    if isinstance(rule, (int, float)) and not isinstance(rule, bool):
+        if not rule > 0:
+            raise ValueError(f"vce_bwidth must be positive, got {rule}")
+        return float(rule)
+    sd = float(np.std(e, ddof=1))
+    if rule == "ivqr":
+        return 1.364 * (2.0 * np.sqrt(np.pi)) ** (-0.2) * sd * n ** (-0.2)
+    if rule == "silverman":
+        iqr = _stata_pctile(e, 75.0) - _stata_pctile(e, 25.0)
+        return 0.9 * min(sd, iqr / 1.349) * n ** (-0.2)
+    raise ValueError(
+        f"vce_bwidth must be 'silverman', 'ivqr' or a positive number, got {rule!r}"
+    )
+
+
+def _kernel_se(
+    Y: np.ndarray,
+    D: np.ndarray,
+    X: np.ndarray,
+    Phi: np.ndarray,
+    alpha_hat: np.ndarray,
+    beta_hat: np.ndarray,
+    tau: float,
+    kernel: str = "epanechnikov",
+    bwidth: Union[str, float] = "silverman",
+) -> Tuple[np.ndarray, float]:
+    """Sandwich SEs of ``(alpha, beta)`` (Chernozhukov-Hansen 2006).
+
+    ``V = J^{-1} S J^{-T} / n`` with ``S = tau(1-tau) Psi'Psi / n``,
+    ``J = (n h)^{-1} sum K(e_i/h) Psi_i (D_i, X_i)'``, ``Psi = [Phi, X]``
+    and ``e = Y - D alpha - X beta`` (instrument term dropped). Stata
+    ``ivqregress`` defaults: Epanechnikov kernel, Silverman bandwidth;
+    ``kernel='uniform', bwidth='ivqr'`` is R ``IVQR::ivqr.vc``. Like IVQR,
+    ``h`` is enlarged by 10% (with a warning) until ``J`` is invertible.
+    """
+    n = len(Y)
+    e = Y - D @ alpha_hat - X @ beta_hat
+    Psi = np.column_stack([Phi, X])
+    DX = np.column_stack([D, X])
+    h = _vce_bandwidth(e, bwidth)
+    S = tau * (1.0 - tau) * (Psi.T @ Psi) / n
+    warned = False
+    for _ in range(200):
+        k = _vce_kernel(e / h, kernel)
+        J = (Psi * k[:, None]).T @ DX / (n * h)
+        try:
+            invJ = np.linalg.inv(J)
+            if np.all(np.isfinite(invJ)):
+                break
+        except np.linalg.LinAlgError:
+            pass
+        if not warned:
+            warnings.warn(
+                "ivqreg: the kernel Jacobian is singular at the chosen "
+                "bandwidth; enlarging it by 10% until invertible "
+                "(as R IVQR does).",
+                RuntimeWarning,
+                stacklevel=3,
+            )
+            warned = True
+        h *= 1.1
+    else:  # pragma: no cover - pathological design
+        raise RuntimeError("ivqreg: kernel Jacobian never became invertible")
+    V = invJ @ S @ invJ.T / n
+    return np.sqrt(np.diag(V)), float(h)
+
+
